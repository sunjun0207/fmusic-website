# 由 10-fmusic-select-templates.sh 在容器启动时渲染。
# ${VITE_*_TARGET} 来自 compose env_file 加载的 .env.dev / .env.test / .env.pro。

root  /usr/share/nginx/html;
index index.html;

proxy_connect_timeout 10s;
proxy_send_timeout    30s;
proxy_read_timeout    60s;

location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 'ok';
}

location /assets/ {
    expires 1y;
    try_files $uri =404;
}

location / {
    expires -1;
    try_files $uri $uri/ /index.html;
}

location /api-fmusic-pomelo7-server/kw-search/ {
    proxy_pass ${VITE_KW_SEARCH_TARGET}/;
    include /etc/nginx/snippets/proxy-common.conf;
}

location /api-fmusic-pomelo7-server/kw-openapi/ {
    proxy_pass ${VITE_KW_OPENAPI_TARGET}/;
    include /etc/nginx/snippets/proxy-common.conf;
}

location /api-fmusic-pomelo7-server/kw-nmobi/ {
    proxy_pass ${VITE_KW_NMOBI_TARGET}/;
    include /etc/nginx/snippets/proxy-common.conf;
    proxy_set_header User-Agent "okhttp/3.10.0";
}

location /api-fmusic-pomelo7-server/kw-img/ {
    proxy_pass ${VITE_KW_IMG_TARGET}/;
    include /etc/nginx/snippets/proxy-common.conf;
    expires 7d;
}

location /api-fmusic-pomelo7-server/kw-comment/ {
    proxy_pass ${VITE_KW_COMMENT_TARGET}/;
    include /etc/nginx/snippets/proxy-common.conf;
    proxy_set_header Referer "https://www.kuwo.cn/";
    proxy_set_header User-Agent "Mozilla/5.0";
}

location /api-fmusic-pomelo7-server/kw-wapi/ {
    proxy_pass ${VITE_KW_WAPI_TARGET}/;
    include /etc/nginx/snippets/proxy-common.conf;
}

location /api-fmusic-pomelo7-server/kw-cdn/ {
    proxy_pass ${VITE_KW_CDN_TARGET}/;
    include /etc/nginx/snippets/proxy-common.conf;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
}

location ~* ^/api-fmusic-pomelo7-server/kw-audio/(?<audio_host>(?!.*\.\.)[a-z0-9.-]+\.kuwo\.cn)/ {
    resolver 223.5.5.5 119.29.29.29 valid=300s ipv6=off;
    resolver_timeout 5s;
    set $audio_backend $audio_host;
    rewrite ^/api-fmusic-pomelo7-server/kw-audio/[^/]+(/.*)$ $1 break;
    proxy_pass http://$audio_backend$uri$is_args$args;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $audio_host;
    proxy_set_header Cookie "";
    proxy_set_header Referer "";
    proxy_set_header Accept-Encoding "";
    proxy_hide_header Content-Disposition;
    proxy_redirect ~*^https?://([a-z0-9.-]+\.kuwo\.cn)(/.*)$ /api-fmusic-pomelo7-server/kw-audio/$1$2;
    proxy_connect_timeout 5s;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
}

location /api-fmusic-pomelo7-server/ {
    default_type text/plain;
    return 404;
}
